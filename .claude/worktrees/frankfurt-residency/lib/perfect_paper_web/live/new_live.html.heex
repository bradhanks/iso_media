<.app
  active={:new}
  title={gettext("New review")}
  flash={@flash}
  current_scope={@current_scope}
  credit_alert={@credit_alert}
  low_credit_dismissed?={@low_credit_dismissed?}
  current_workspace={@current_workspace}
  workspaces={@workspaces}
>
  <%= if @credits_low_warning do %>
    <div class="alert alert-warning mb-6" role="alert">
      <.icon name="hero-exclamation-triangle" class="size-5 shrink-0" />
      <span>
        <%= if @credits_low_warning == :annual do %>
          {gettext(
            "Your credit balance is running low. Add a credit pack to keep reviews flowing."
          )}
        <% else %>
          {gettext(
            "Your credit balance is running low. Switch to annual and save 17% — or add credits to keep going."
          )}
        <% end %>
      </span>
    </div>
  <% end %>

  <div class="mb-8 text-center">
    <h1 class="ds-h2 mb-2">{gettext("Start a new review")}</h1>
    <p class="ds-lead mx-auto max-w-2xl text-base-content/70">
      {gettext(
        "Upload your manuscript and PerfectPaper will read it the way a thoughtful reviewer would."
      )}
    </p>
  </div>

  <div class="grid gap-6 lg:grid-cols-[1fr_300px] lg:items-start">
    <%!-- ── Upload column ───────────────────────────────────────────────── --%>
    <form id="upload-form" phx-submit="submit" phx-change="validate">
      <div
        class="grid min-h-[340px] place-items-center rounded-box border-2 border-dashed border-base-300 bg-base-200/40 p-8 text-center"
        phx-drop-target={@uploads.manuscript.ref}
      >
        <div>
          <div class="mx-auto mb-4 grid size-14 place-items-center rounded-box bg-primary/10 text-primary">
            <.icon name="hero-document-arrow-up" class="size-7" />
          </div>
          <p class="font-display text-xl font-semibold">
            {gettext("Drag and drop your file here")}
          </p>
          <p class="mt-2 font-sans text-sm text-base-content/55">
            {gettext("Drag your manuscript here, or")}
            <label
              for={@uploads.manuscript.ref}
              class="cursor-pointer font-semibold text-primary"
            >
              {gettext("browse")}
            </label>
          </p>
          <p class="mt-1 font-sans text-xs text-base-content/45">
            {gettext("DOCX · up to 25 MB")}
          </p>
          <.live_file_input upload={@uploads.manuscript} class="sr-only" />
        </div>
      </div>

      <%!-- selected file + per-entry errors --%>
      <div
        :for={entry <- @uploads.manuscript.entries}
        class="mt-4 rounded-box border border-base-300 p-4"
      >
        <div class="flex items-center justify-between gap-3">
          <span class="truncate font-sans text-sm">{entry.client_name}</span>
          <button
            type="button"
            class="btn btn-ghost btn-xs"
            phx-click="cancel"
            phx-value-ref={entry.ref}
            aria-label={gettext("Remove file")}
          >
            {gettext("Remove")}
          </button>
        </div>
        <progress class="progress progress-primary mt-2 w-full" value={entry.progress} max="100" />
        <p :for={err <- upload_errors(@uploads.manuscript, entry)} class="mt-1 text-sm text-error">
          {error_text(err)}
        </p>
      </div>

      <p :for={err <- upload_errors(@uploads.manuscript)} class="mt-2 text-sm text-error">
        {error_text(err)}
      </p>
      <p :if={@error} class="mt-2 text-sm text-error">{@error}</p>

      <button
        type="submit"
        class="btn btn-primary btn-block mt-6 font-sans font-semibold"
        disabled={@uploads.manuscript.entries == []}
        phx-disable-with={gettext("Uploading…")}
      >
        {gettext("Start review")}
      </button>
    </form>

    <%!-- ── Reassurance column ──────────────────────────────────────────── --%>
    <div class="flex flex-col gap-3">
      <div class="grid grid-cols-2 gap-3">
        <.reassure_card title={gettext("Analysis takes 10–30 min")}>
          <circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" />
        </.reassure_card>
        <.reassure_card title={gettext("We email you when ready")}>
          <rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 7l9 6 9-6" />
        </.reassure_card>
        <.reassure_card title={gettext("Completely secure")}>
          <rect x="5" y="11" width="14" height="9" rx="2" /><path d="M8 11V8a4 4 0 018 0v3" />
        </.reassure_card>
        <.reassure_card title={gettext("Never used to train models")}>
          <circle cx="12" cy="12" r="9" /><path d="M8 12h8" />
        </.reassure_card>
      </div>

      <figure class="rounded-box border border-base-300 bg-base-100 p-4">
        <blockquote class="font-display text-sm font-semibold leading-snug">
          {gettext("“Would have taken an expert many hours to complete.”")}
        </blockquote>
        <p class="mt-2 font-serif text-xs italic leading-relaxed text-base-content/65">
          {gettext(
            "The depth of the reading was impressive, and identified subtle issues — even working with ChatGPT Pro."
          )}
        </p>
        <figcaption class="mt-2.5 font-sans text-[11px]">
          <span class="font-semibold">{gettext("Omer Tamuz")}</span>
          <span class="text-base-content/55">{gettext("· Professor, Caltech")}</span>
        </figcaption>
      </figure>
    </div>
  </div>
</.app>
