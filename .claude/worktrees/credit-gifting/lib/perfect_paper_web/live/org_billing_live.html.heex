<div class="mx-auto max-w-3xl p-6">
  <h1 class="ds-h2">{gettext("Billing")}</h1>

  <section
    :if={is_nil(@contract)}
    id="billing-no-contract"
    class="mt-6 rounded-box border border-base-300 bg-base-100 p-4"
  >
    <p class="ds-p">{gettext("No enterprise contract is configured for this organization.")}</p>
    <p class="ds-p mt-1">
      {gettext("Credit pool:")} <span id="billing-pool" class="font-semibold">{@pool}</span>
    </p>
  </section>

  <section :if={@contract} class="mt-6 rounded-box border border-base-300 bg-base-100 p-4">
    <h2 class="ds-h3">{gettext("Contract")}</h2>
    <dl class="mt-3 grid grid-cols-2 gap-3 text-sm">
      <dt class="text-base-content/65">{gettext("Status")}</dt>
      <dd id="billing-status" class="font-medium capitalize">{@contract.status}</dd>

      <dt class="text-base-content/65">{gettext("Seats used / contracted")}</dt>
      <dd>
        <span id="billing-seats-used" class="font-medium">{@seats_used}</span>
        <span class="text-base-content/65">/ {@contract.seats}</span>
      </dd>

      <dt :if={@seat_overage > 0} class="text-warning">{gettext("Seat overage")}</dt>
      <dd :if={@seat_overage > 0} id="billing-overage" class="font-medium text-warning">
        {gettext("%{count} over (trued up on the next invoice)", count: @seat_overage)}
      </dd>

      <dt class="text-base-content/65">{gettext("Price per seat")}</dt>
      <dd>{dollars(@contract.price_per_seat_cents)} / {@contract.interval}</dd>

      <dt class="text-base-content/65">{gettext("Credit pool")}</dt>
      <dd id="billing-pool" class={["font-semibold", @pool < 0 && "text-warning"]}>{@pool}</dd>

      <dt class="text-base-content/65">{gettext("Term")}</dt>
      <dd>{@contract.term_start} – {@contract.term_end}</dd>

      <dt :if={@contract.po_number} class="text-base-content/65">{gettext("PO")}</dt>
      <dd :if={@contract.po_number}>{@contract.po_number}</dd>
    </dl>
  </section>

  <section class="mt-6 rounded-box border border-base-300 bg-base-100 p-4">
    <h2 class="ds-h3">{gettext("Invoices")}</h2>
    <p :if={@invoices == []} class="ds-p">{gettext("No invoices yet.")}</p>
    <table :if={@invoices != []} class="mt-2 w-full text-sm">
      <thead>
        <tr class="text-left text-base-content/65">
          <th class="py-1">{gettext("Number")}</th>
          <th>{gettext("Period")}</th>
          <th>{gettext("Amount")}</th>
          <th>{gettext("Status")}</th>
          <th>{gettext("Due")}</th>
        </tr>
      </thead>
      <tbody>
        <tr :for={inv <- @invoices} id={"invoice-#{inv.id}"} class="border-t border-base-200">
          <td class="py-1 font-mono text-xs">{inv.number}</td>
          <td>{inv.period_start} – {inv.period_end}</td>
          <td>{dollars(inv.amount_cents)}</td>
          <td id={"invoice-#{inv.id}-status"} class="capitalize">{inv.status}</td>
          <td>{Calendar.strftime(inv.due_at, "%Y-%m-%d")}</td>
        </tr>
      </tbody>
    </table>
  </section>
</div>
